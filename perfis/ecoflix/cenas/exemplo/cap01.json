 "linhas": [
  {
   "i": 0,
   "texto": "O caminhão chega cheio e para na balança: esse é o peso bruto.",
   "s": 0.4,
   "e": 5.335
  },
  {
   "i": 1,
   "texto": "Depois de descarregar, ele pesa de novo, vazio: essa é a tara.",
   "s": 5.685,
   "e": 10.92
  },
  {
   "i": 2,
   "texto": "O peso líquido é a conta: caminhão cheio menos caminhão vazio.",
   "s": 11.27,
   "e": 16.204
  },
  {
   "i": 3,
   "texto": "Sobra só o peso da sucata, e é ele que vai para o pedido.",
   "s": 16.554,
   "e": 21.109
  }
 ]
