 "linhas": [
  {
   "i": 0,
   "texto": "O caminhão chega cheio e para na balança: essa é a primeira pesagem.",
   "s": 0.4,
   "e": 5.791
  },
  {
   "i": 1,
   "texto": "Depois de descarregar, ele pesa de novo, vazio: essa é a segunda pesagem.",
   "s": 6.141,
   "e": 12.211
  },
  {
   "i": 2,
   "texto": "A diferença entre as duas é a conta: caminhão cheio menos caminhão vazio.",
   "s": 12.561,
   "e": 18.331
  },
  {
   "i": 3,
   "texto": "Sobra só o peso da sucata, e é ele que vai para o pedido.",
   "s": 18.681,
   "e": 23.236
  }
 ]
