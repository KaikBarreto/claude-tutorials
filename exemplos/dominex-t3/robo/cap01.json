{
  "name": "t3-cap01",
  "title": "T3 · Cap. 1 · A tela de Clientes (narração 49,5 s; marcas L1..L6 = início de cada linha do roteiro)",
  "seed": "t3-cap01",
  "pace": 1.0,
  "cps": 9,
  "tail": 1.5,
  "start": { "x": 640, "y": 430 },
  "prewarm": ["/dashboard", "/clientes"],
  "setup": [
    { "do": "goto", "url": "/dashboard" },
    { "do": "waitFor", "idle": true }
  ],
  "steps": [
    { "do": "mark", "name": "L1", "at": 0 },
    { "do": "click", "target": { "role": "button", "name": "Gestão", "exact": true }, "at": 2.0, "label": "abre o grupo Gestão do menu" },
    { "do": "click", "target": { "role": "link", "name": "Clientes e Fornecedores" }, "at": 3.7, "label": "Clientes e Fornecedores" },
    { "do": "waitFor", "text": "Lista de Clientes" },

    { "do": "mark", "name": "L2", "at": 5.64 },
    { "do": "hover", "target": { "role": "tab", "name": "Clientes" }, "seconds": 0.9, "at": 6.2, "label": "aba Clientes" },
    { "do": "hover", "target": { "role": "tab", "name": "Fornecedores" }, "seconds": 0.9, "label": "aba Fornecedores" },
    { "do": "hover", "target": { "text": "Lista de Clientes", "exact": true }, "seconds": 1.4, "at": 10.6, "label": "lista à esquerda" },
    { "do": "hover", "target": { "text": "Selecione um cliente", "exact": true }, "seconds": 1.6, "at": 12.8, "label": "painel da ficha à direita" },

    { "do": "mark", "name": "L3", "at": 15.8 },
    { "do": "click", "target": { "text": "Padaria Bom Grão", "exact": true }, "at": 16.0, "label": "abre a ficha da Padaria" },
    { "do": "waitFor", "text": "INFORMAÇÕES" },
    { "do": "click", "target": { "text": "Hotel Mirante do Mar", "exact": true }, "at": 19.6, "label": "troca para o Hotel" },
    { "do": "waitFor", "text": "Hotel Mirante do Mar", "optional": true },

    { "do": "mark", "name": "L4", "at": 23.09 },
    { "do": "hover", "target": { "text": "91.234.502/0001-32", "exact": false }, "seconds": 2.4, "at": 23.5, "label": "documento, telefone e cidade da linha" },
    { "do": "hover", "target": { "text": "PJ", "exact": true }, "seconds": 1.8, "at": 26.6, "label": "etiqueta PJ" },

    { "do": "mark", "name": "L5", "at": 30.77 },
    { "do": "type", "target": { "placeholder": "Buscar clientes..." }, "text": "mirante", "cps": 7, "at": 31.4, "label": "busca por 'mirante'" },
    { "do": "pause", "seconds": 3.2 },
    { "do": "press", "key": ["Control+a", "Backspace"], "at": 36.8, "label": "limpa a busca" },
    { "do": "pause", "seconds": 0.8 },

    { "do": "mark", "name": "L6", "at": 39.33 },
    { "do": "hover", "target": { "role": "button", "name": "Configurar origens" }, "seconds": 1.0, "at": 42.6, "label": "botão Configurar origens" },
    { "do": "hover", "target": { "role": "button", "name": "Formulários de captação" }, "seconds": 1.0, "at": 44.6, "label": "botão Formulários de captação" },
    { "do": "hover", "target": { "role": "button", "name": "Novo Cliente" }, "seconds": 2.2, "at": 46.4, "label": "botão Novo Cliente" },
    { "do": "mark", "name": "FIM", "at": 49.5 }
  ]
}
