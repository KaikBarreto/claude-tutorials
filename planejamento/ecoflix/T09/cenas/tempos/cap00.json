 "linhas": [
  {
   "i": 0,
   "texto": "Oi! Neste tutorial a gente vai achar aquele pedido de três semanas atrás, corrigir o que saiu errado e imprimir o comprovante de novo.",
   "s": 0.4,
   "e": 10.803
  },
  {
   "i": 1,
   "texto": "Na Recicla Vale Metais, a Auto Peças Vale Forte ligou pedindo o comprovante da bateria que vendeu em vinte e um de outubro. E o pedido não aparece no nome dela.",
   "s": 11.153,
   "e": 23.531
  },
  {
   "i": 2,
   "texto": "Pra resolver, a gente usa duas telas: Pedidos, no menu lateral, e Histórico do Caixa, dentro de Financeiro.",
   "s": 23.881,
   "e": 32.834
  },
  {
   "i": 3,
   "texto": "Se você ainda não viu o tutorial Ticket de Pesagem, dá uma olhada antes. Primeiro, o trabalho de cada tela.",
   "s": 33.184,
   "e": 42.186
  }
 ]
