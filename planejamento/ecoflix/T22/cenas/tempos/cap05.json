 "linhas": [
  {
   "i": 0,
   "texto": "E o ranking ordena as unidades pelo lucro. Em outubro, a filial ficou na frente, e a matriz, no vermelho.",
   "s": 0.4,
   "e": 8.901
  },
  {
   "i": 1,
   "texto": "Embaixo vem o resumo por unidade, em números.",
   "s": 9.251,
   "e": 12.894
  },
  {
   "i": 2,
   "texto": "A matriz teve duzentos e setenta e dois mil e quarenta de receita e duzentos e noventa e nove mil, seiscentos e noventa de despesa. Ficou negativa em vinte e sete mil, seiscentos e cinquenta reais.",
   "s": 13.244,
   "e": 28.582
  },
  {
   "i": 3,
   "texto": "A filial vendeu setenta e dois mil, gastou setenta e um mil e lucrou mil reais.",
   "s": 28.932,
   "e": 35.158
  },
  {
   "i": 4,
   "texto": "Repara no vermelho da matriz. É que aqui entra a compra inteira do mês, até o material que ainda está no pátio esperando venda. Isso fica claro na DRE, com o regime de competência.",
   "s": 35.508,
   "e": 50.011
  }
 ]
}