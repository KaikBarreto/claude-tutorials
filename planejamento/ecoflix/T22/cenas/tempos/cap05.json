 "linhas": [
  {
   "i": 0,
   "texto": "E o ranking ordena as unidades pelo lucro. Em outubro, a matriz ficou na frente.",
   "s": 0.4,
   "e": 6.702
  },
  {
   "i": 1,
   "texto": "Embaixo vem o resumo por unidade, em números.",
   "s": 7.052,
   "e": 10.696
  },
  {
   "i": 2,
   "texto": "A matriz vendeu cento e oitenta e seis mil, gastou cento e oitenta mil e lucrou seis mil reais. Margem de três vírgula dois por cento.",
   "s": 11.046,
   "e": 21.449
  },
  {
   "i": 3,
   "texto": "A filial vendeu setenta e dois mil, gastou setenta e um mil e lucrou mil reais.",
   "s": 21.799,
   "e": 28.025
  },
  {
   "i": 4,
   "texto": "Repara que a margem é pequena. É que aqui entra a compra inteira do mês, até o material que ainda está no pátio esperando venda. Isso fica claro na DRE, com o regime de competência.",
   "s": 28.375,
   "e": 42.953
  }
 ]
