 "linhas": [
  {
   "i": 0,
   "texto": "E o ranking ordena as unidades pelo saldo, a receita menos a despesa. Em outubro, a filial ficou na frente, e a matriz, no vermelho.",
   "s": 0.0,
   "e": 9.16
  },
  {
   "i": 1,
   "texto": "Embaixo vem o resumo por unidade, em números.",
   "s": 9.48,
   "e": 12.44
  },
  {
   "i": 2,
   "texto": "A matriz teve duzentos e setenta e dois mil e quarenta de receita e duzentos e noventa e nove mil, seiscentos e noventa de despesa. Ficou negativa em vinte e sete mil, seiscentos e cinquenta reais.",
   "s": 12.76,
   "e": 25.22
  },
  {
   "i": 3,
   "texto": "A filial vendeu setenta e dois mil, gastou setenta e um mil e ficou com mil reais de saldo.",
   "s": 25.22,
   "e": 31.46
  },
  {
   "i": 4,
   "texto": "Repara no vermelho da matriz. É que aqui entra a compra inteira do mês, até o material que ainda está no pátio esperando venda. Por isso esse saldo não é igual ao Lucro Líquido do cartão, que segue a DRE em competência.",
   "s": 31.7,
   "e": 45.492
  }
 ],
