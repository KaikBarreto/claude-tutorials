 "linhas": [
  {
   "i": 0,
   "texto": "Agora do lado da filial. A Sandra, gerente em Pindamonhangaba, entra no sistema da filial, em Configurações, na aba Empresa.",
   "s": 0.4,
   "e": 10.494
  },
  {
   "i": 1,
   "texto": "Lá embaixo fica o cartão Filial. Ela liga o É Filial.",
   "s": 10.844,
   "e": 14.945
  },
  {
   "i": 2,
   "texto": "E cola o código que recebeu da matriz.",
   "s": 15.295,
   "e": 18.257
  },
  {
   "i": 3,
   "texto": "Vincular. Pronto, a filial está no Grupo Recicla Vale.",
   "s": 18.607,
   "e": 22.934
  },
  {
   "i": 4,
   "texto": "Do lado dela, o dia a dia segue igual: a filial continua usando o próprio sistema, e a matriz passa a enxergar os números.",
   "s": 23.284,
   "e": 33.076
  }
 ]
