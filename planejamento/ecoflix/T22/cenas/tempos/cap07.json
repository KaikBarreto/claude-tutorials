 "linhas": [
  {
   "i": 0,
   "texto": "Agora o mesmo outubro em regime de competência. No lugar das compras entra o CMV, o custo só do material que foi vendido: cento e noventa e quatro mil.",
   "s": 0.4,
   "e": 12.7
  },
  {
   "i": 1,
   "texto": "E o resultado do mês sobe pra trinta e três mil reais.",
   "s": 13.05,
   "e": 17.227
  },
  {
   "i": 2,
