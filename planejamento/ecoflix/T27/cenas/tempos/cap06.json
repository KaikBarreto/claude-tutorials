 "linhas": [
  {
   "i": 0,
   "texto": "E a equipe? A troca vale pra empresa toda. Esse aqui é o sistema da Juliana, do escritório.",
   "s": 0.4,
   "e": 7.537
  },
  {
   "i": 1,
   "texto": "Mesmo logo, mesma cor, e ela não precisou mexer em nada.",
   "s": 7.887,
   "e": 12.516
  },
  {
   "i": 2,
   "texto": "Quando o White Label é ligado, ou a cor é salva, quem estiver com o sistema aberto vê a mudança na hora, sem sair e entrar de novo.",
   "s": 12.866,
   "e": 23.342
  },
  {
   "i": 3,
   "texto": "E quem muda o White Label é quem pode mexer na aba Empresa. A Juliana só vê o resultado.",
   "s": 23.692,
   "e": 30.451
  }
 ]
