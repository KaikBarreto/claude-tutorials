 "linhas": [
  {
   "i": 0,
   "texto": "E se um dia você quiser voltar atrás? Tem dois caminhos, e eles não fazem a mesma coisa.",
   "s": 0.0,
   "e": 5.4
  },
  {
   "i": 1,
   "texto": "O primeiro é o interruptor. Desligo, e o sistema avisa: White Label desativado.",
   "s": 5.72,
   "e": 11.48
  },
  {
   "i": 2,
   "texto": "O menu voltou pro logo do EcoSistema, e a cor voltou ao padrão.",
   "s": 11.72,
   "e": 15.48
  },
  {
   "i": 3,
   "texto": "Ligo de novo. A cor da Recicla Vale continuou guardada: voltou tudo, sem digitar nada.",
   "s": 15.72,
   "e": 21.8
  },
  {
   "i": 4,
   "texto": "O segundo caminho é remover o logo. A tela pergunta antes. Confirmo em Remover.",
   "s": 21.94,
   "e": 27.7
  },
  {
   "i": 5,
   "texto": "Repara: o menu voltou pro logo do EcoSistema, mas o White Label continua ativo. E a tela pede o logo de volta.",
   "s": 27.94,
   "e": 35.3
  },
  {
   "i": 6,
   "texto": "Ou seja, só remover o logo não desliga nada: os documentos continuam sem o rodapé do EcoSistema. Pra desligar de verdade, use o interruptor.",
   "s": 35.54,
   "e": 44.804
  },
  {
   "i": 7,
   "texto": "Agora eu mando o logo de novo, e está tudo no lugar.",
   "s": 44.804,
   "e": 48.004
  }
 ],
