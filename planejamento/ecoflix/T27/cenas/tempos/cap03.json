 "linhas": [
  {
   "i": 0,
   "texto": "Com as imagens no lugar, é hora de ligar.",
   "s": 0.0,
   "e": 2.52
  },
  {
   "i": 1,
   "texto": "Uma dica: quem libera esse interruptor é o logo. Sem logo enviado, ele fica travado, e a tela pede o upload antes.",
   "s": 2.76,
