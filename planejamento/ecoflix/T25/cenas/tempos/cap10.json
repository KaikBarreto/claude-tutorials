 "linhas": [
  {
   "i": 0,
   "texto": "E uma vez por mês, o fechamento: umas duas horas, em quatro passos.",
   "s": 0.4,
   "e": 6.015
  },
  {
   "i": 1,
   "texto": "Conciliar o extrato do banco com o sistema e conferir o DRE do mês, no Relatório Financeiro.",
   "s": 6.365,
   "e": 14.034
  },
  {
   "i": 2,
   "texto": "Mandar o pacote das notas pro contador e ver se ficou algum MTR ou CDF pendente. Esses dois dependem do módulo de notas fiscais, do plano contratado.",
   "s": 14.384,
   "e": 26.989
  },
  {
   "i": 3,
   "texto": "Pra não esquecer, a gente marca o fechamento na Agenda, no primeiro dia útil: terça, primeiro de dezembro.",
   "s": 27.339,
   "e": 36.066
  },
  {
   "i": 4,
   "texto": "Nova Tarefa: Fechamento de novembro, com os quatro passos na descrição, às oito da manhã, e Lembrar no dia ligado. No dia, ela aparece logo cedo.",
   "s": 36.416,
   "e": 48.254
  }
 ]
