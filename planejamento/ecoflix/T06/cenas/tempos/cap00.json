 "linhas": [
  {
   "i": 0,
   "texto": "Oi! Neste tutorial a gente vai cuidar do dinheiro do dia na Recicla Vale Metais.",
   "s": 0.4,
   "e": 6.552
  },
  {
   "i": 1,
   "texto": "No ferro-velho, quase toda compra de sucata é paga em dinheiro vivo. Se o caixa não bate no fim do dia, ninguém sabe onde foi parar a diferença.",
   "s": 6.902,
   "e": 18.215
  },
  {
   "i": 2,
   "texto": "Então a gente vai ver com quanto o caixa abre, com quanto ele fecha, e onde fica o dinheiro da empresa quando não tem caixa aberto.",
   "s": 18.565,
   "e": 28.89
  },
  {
   "i": 3,
   "texto": "Tudo isso fica no menu lateral, em Financeiro, Caixa.",
   "s": 29.24,
   "e": 33.641
  },
  {
   "i": 4,
   "texto": "Se você ainda não viu o tutorial Balança e impressora, o EcoTray, dá uma olhada antes. Vamos começar pela tela com o caixa fechado.",
   "s": 33.991,
   "e": 44.816
  }
 ]
