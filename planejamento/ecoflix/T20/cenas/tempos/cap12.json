 "linhas": [
  {
   "i": 0,
   "texto": "E se a cooperativa precisar do comprovante de uma entrega? Ela mesma imprime, aqui na impressora do pedido.",
   "s": 0.0,
   "e": 6.12
  },
  {
   "i": 1,
   "texto": "Abre o comprovante em A4, como a gente escolheu na aba Portal, com os materiais, os pesos e os valores da entrega.",
   "s": 6.36,
   "e": 13.56
  },
  {
   "i": 2,
   "texto": "E como esse pedido tem fotos, o comprovante sai com um QR Code: Escaneie para ver fotos.",
   "s": 13.72,
   "e": 19.72
  },
  {
   "i": 3,
   "texto": "Num pedido com o Comprovante sem valores, o papel sai sem os preços, igual ao portal. O valor nem passa pelo navegador do parceiro.",
