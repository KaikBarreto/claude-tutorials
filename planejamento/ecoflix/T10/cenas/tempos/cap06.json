 "linhas": [
  {
   "i": 0,
   "texto": "Toda linha de compra ou de venda abre o pedido que gerou ela. Clicando na compra de ontem, aparece o que veio.",
   "s": 0.4,
   "e": 8.98
  },
  {
   "i": 1,
   "texto": "Oitocentos e sessenta quilos de ferro pesado, a noventa e cinco centavos, deu oitocentos e dezessete reais.",
   "s": 9.33,
   "e": 17.833
  },
  {
   "i": 2,
   "texto": "Embaixo, o fornecedor, o Depósito Irmãos Siqueira, como foi pago, no Pix, e o total do pedido.",
   "s": 18.183,
   "e": 26.148
  },
  {
   "i": 3,
   "texto": "E as fotos tiradas na hora da compra. Clicando, a foto amplia.",
   "s": 26.498,
   "e": 31.433
  },
  {
   "i": 4,
   "texto": "Quando o contador pergunta de onde veio o ferro, a resposta está aqui: o pedido, o pagamento e as fotos, na mesma linha.",
   "s": 31.783,
   "e": 41.573
  }
 ]
