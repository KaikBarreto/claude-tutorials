 "linhas": [
  {
   "i": 0,
   "texto": "Gerador é quem produz o resíduo. Transportador é quem leva. E destinador é quem recebe e dá o destino, como reciclar.",
   "s": 0.4,
   "e": 9.512
  },
  {
   "i": 1,
   "texto": "O MTR, o manifesto de transporte de resíduos, acompanha a carga do gerador até o destino.",
   "s": 9.862,
   "e": 17.605
  },
  {
   "i": 2,
   "texto": "E o CDF, o certificado de destinação final, é o destinador confirmando que recebeu e deu o destino.",
   "s": 17.955,
   "e": 26.306
  },
