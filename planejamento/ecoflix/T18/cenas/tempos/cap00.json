 "linhas": [
  {
   "i": 0,
   "texto": "Oi! Neste tutorial a gente vai cuidar da parte que mantém a licença da Recicla Vale Metais de pé: o manifesto de cada carga de resíduo e o certificado do destino.",
   "s": 0.4,
   "e": 12.93
  },
  {
   "i": 1,
   "texto": "Hoje sai uma carga de chaparia pra Aços Quiririm. E a Auto Peças Vale Forte espera o certificado das sucatas que mandou em outubro.",
   "s": 13.28,
   "e": 23.305
  },
  {
   "i": 2,
   "texto": "Tudo isso fica no menu Fiscal & Ambiental, em Ambiental.",
   "s": 23.655,
   "e": 28.134
  },
  {
   "i": 3,
   "texto": "O Ambiental faz parte do módulo de Notas Fiscais, então depende do plano contratado.",
   "s": 28.484,
   "e": 35.09
  },
  {
   "i": 4,
   "texto": "Se você ainda não viu o tutorial de transporte, serviço e o contador, dá uma olhada antes. Primeiro, o que é cada um.",
   "s": 35.44,
   "e": 45.352
  }
 ]
