 "linhas": [
  {
   "i": 0,
   "texto": "Pronto! Recapitulando: a gente abriu a compra pelo caixa, pelo atalho e pelo Ctrl+K, viu o Não informado e cadastrou o Zé na hora.",
   "s": 0.0,
   "e": 9.16
  },
  {
   "i": 1,
   "texto": "Viu qual preço vale, puxou o peso da balança, descontou a tara e a impureza, e fez a dupla pesagem da carroça.",
   "s": 9.32,
   "e": 16.68
  },
  {
   "i": 2,
   "texto": "Mesclou a latinha, fechou o valor do ferro, abriu dois pedidos ao mesmo tempo, trocou o fornecedor com item lançado, e descartou e recuperou um rascunho.",
   "s": 16.84,
   "e": 26.852
  },
  {
   "i": 3,
   "texto": "Pagou o Zé em dinheiro, viu a compra abater o vale do Valdir e, na compra da oficina, pagou em dinheiro, Pix e fiado em duas parcelas.",
   "s": 27.012,
   "e": 35.572
  },
  {
   "i": 4,
   "texto": "Imprimiu o cupom, vendeu com o lucro estimado na tela e o cupom sem valor pro motorista, cobriu o estoque que faltava e comprou sem internet.",
   "s": 35.732,
   "e": 44.292
  },
  {
   "i": 5,
   "texto": "E pra corrigir uma compra ou uma venda de um caixa que já fechou, sem reabrir o caixa, tem o tutorial Pedidos e histórico do caixa.",
   "s": 44.74,
   "e": 52.98
  },
  {
   "i": 6,
   "texto": "No próximo tutorial, o caminhão que chega na balança antes de o preço estar fechado: o Ticket de Pesagem. Até lá!",
   "s": 53.22,
   "e": 60.66
  }
 ],
