 "linhas": [
  {
   "i": 0,
   "texto": "Em Pedidos fica o resumo das compras. Desde agosto, a Recicla fez catorze pedidos com a cooperativa.",
   "s": 0.4,
   "e": 8.221
  },
  {
   "i": 1,
   "texto": "O gráfico mostra os cinco materiais que ela mais traz. E ele conta o peso, em quilos.",
   "s": 8.571,
   "e": 15.253
  },
  {
   "i": 2,
   "texto": "O papelão sozinho é cinquenta e nove por cento de tudo que chega da cooperativa.",
   "s": 15.603,
   "e": 21.754
  },
  {
   "i": 3,
   "texto": "Já a latinha é só nove por cento do peso. Mas o quilo da latinha vale seis e vinte, e o do papelão, cinquenta e cinco centavos.",
   "s": 22.104,
   "e": 32.126
  },
  {
   "i": 4,
   "texto": "No Período, dá pra olhar um mês só. E embaixo fica cada pedido, com o valor e a data.",
   "s": 32.476,
   "e": 39.308
  }
 ]
