    { "do": "click", "target": { "role": "tab", "name": "Documentos" }, "at": 71.15, "label": "aba Documentos" },
    { "do": "click", "target": { "role": "tab", "name": "Financeiro" }, "at": 72.1, "label": "aba Financeiro" },
    { "do": "press", "key": "ArrowRight", "at": 73.0, "label": "a faixa de abas anda mais um pouco para a direita" },
