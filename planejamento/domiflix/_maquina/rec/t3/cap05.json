    { "do": "hover", "target": { "role": "menuitem", "name": "WhatsApp" }, "seconds": 1.3, "at": 50.3, "label": "WhatsApp do contato (só passa o mouse)" },
    { "do": "hover", "target": { "role": "menuitem", "name": "Editar contato" }, "seconds": 0.3, "at": 52.5, "label": "Editar contato" },
