{
 "seedExtra": [
  "t3/apos-cap10",
  "t1/apos-cap13",
  "t4/inicio",
  "t4/apos-cap14",
  "t5/inicio",
  "t9/inicio"
 ],
 "start": "/dashboard",
 "stopOnFail": false,
 "steps": [
  {
   "do": "goto",
   "url": "/orcamentos"
  },
  {
   "do": "waitFor",
   "text": "Gerencie orçamentos, custos e precificação",
   "timeout": 20
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "click",
   "target": {
    "selector": "main .grid > *",
    "nth": 0
   },
   "after": 1000
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Filtros, 1 ativo"
   },
   "after": 1200
  },
  {
   "do": "shot",
   "name": "110-filtro-aberto"
  },
  {
   "do": "eval",
   "js": "(()=>{const ds=[...document.querySelectorAll('[role=dialog],[data-radix-popper-content-wrapper]')];const root=ds.length?ds[ds.length-1]:document.querySelector('main')||document;return [...root.querySelectorAll('button,input,textarea,select,[role=combobox],[role=switch],[role=checkbox],[role=tab],[role=option],[role=menuitem],[role=slider]')].filter(e=>e.getClientRects().length).map(e=>{const r=e.getBoundingClientRect();return [e.tagName[0],e.type||'',e.getAttribute('role')||'',(e.innerText||'').replace(/\\s+/g,' ').slice(0,38),e.getAttribute('aria-label')||'',e.placeholder||'',(e.value||'').slice(0,14),Math.round(r.x),Math.round(r.y),Math.round(r.width),Math.round(r.height),e.disabled?'D':''].join('|')})})()",
   "max": 6000
  },
  {
   "do": "eval",
   "js": "[...document.querySelectorAll('[role=dialog]')].pop().innerText.slice(0,800)",
   "max": 900
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Enviado",
    "exact": true,
    "within": "[role=dialog]"
   },
   "after": 1000
  },
  {
   "do": "shot",
   "name": "111-filtro-desmarcado"
  },
  {
   "do": "eval",
   "js": "(()=>{const ds=[...document.querySelectorAll('[role=dialog],[data-radix-popper-content-wrapper]')];const root=ds.length?ds[ds.length-1]:document.querySelector('main')||document;return [...root.querySelectorAll('button,input,textarea,select,[role=combobox],[role=switch],[role=checkbox],[role=tab],[role=option],[role=menuitem],[role=slider]')].filter(e=>e.getClientRects().length).map(e=>{const r=e.getBoundingClientRect();return [e.tagName[0],e.type||'',e.getAttribute('role')||'',(e.innerText||'').replace(/\\s+/g,' ').slice(0,38),e.getAttribute('aria-label')||'',e.placeholder||'',(e.value||'').slice(0,14),Math.round(r.x),Math.round(r.y),Math.round(r.width),Math.round(r.height),e.disabled?'D':''].join('|')})})()",
   "max": 6000
  },
  {
   "do": "press",
   "key": "Escape",
   "after": 900
  },
  {
   "do": "shot",
   "name": "112-filtro-fechado"
  },
  {
   "do": "text",
   "selector": "main tbody",
   "name": "lista inteira",
   "max": 300
  },
  {
   "do": "click",
   "target": {
    "selector": "main tbody tr:has-text('Hotel Mirante do Mar') button[aria-haspopup='menu']"
   },
   "after": 800
  },
  {
   "do": "shot",
   "name": "113-menu-hotel"
  },
  {
   "do": "eval",
   "js": "(()=>{const ds=[...document.querySelectorAll('[role=dialog],[data-radix-popper-content-wrapper]')];const root=ds.length?ds[ds.length-1]:document.querySelector('main')||document;return [...root.querySelectorAll('button,input,textarea,select,[role=combobox],[role=switch],[role=checkbox],[role=tab],[role=option],[role=menuitem],[role=slider]')].filter(e=>e.getClientRects().length).map(e=>{const r=e.getBoundingClientRect();return [e.tagName[0],e.type||'',e.getAttribute('role')||'',(e.innerText||'').replace(/\\s+/g,' ').slice(0,38),e.getAttribute('aria-label')||'',e.placeholder||'',(e.value||'').slice(0,14),Math.round(r.x),Math.round(r.y),Math.round(r.width),Math.round(r.height),e.disabled?'D':''].join('|')})})()",
   "max": 6000
  },
  {
   "do": "press",
   "key": "Escape",
   "after": 600
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Novo Orçamento",
    "exact": true
   },
   "after": 1500
  },
  {
   "do": "shot",
   "name": "114-wizard-aberto"
  },
  {
   "do": "eval",
   "js": "[...document.querySelectorAll('[role=dialog]')].pop().innerText.slice(0,900)",
   "max": 1000
  },
  {
   "do": "eval",
   "js": "(()=>{const ds=[...document.querySelectorAll('[role=dialog],[data-radix-popper-content-wrapper]')];const root=ds.length?ds[ds.length-1]:document.querySelector('main')||document;return [...root.querySelectorAll('button,input,textarea,select,[role=combobox],[role=switch],[role=checkbox],[role=tab],[role=option],[role=menuitem],[role=slider]')].filter(e=>e.getClientRects().length).map(e=>{const r=e.getBoundingClientRect();return [e.tagName[0],e.type||'',e.getAttribute('role')||'',(e.innerText||'').replace(/\\s+/g,' ').slice(0,38),e.getAttribute('aria-label')||'',e.placeholder||'',(e.value||'').slice(0,14),Math.round(r.x),Math.round(r.y),Math.round(r.width),Math.round(r.height),e.disabled?'D':''].join('|')})})()",
   "max": 6000
  }
 ]
}