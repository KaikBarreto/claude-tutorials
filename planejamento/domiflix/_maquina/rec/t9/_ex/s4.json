   },
   "after": 1200
  },
  {
   "do": "shot",
   "name": "90-veiculo-vazio"
  },
  {
   "do": "keys",
   "target": {
    "placeholder": "Ex: Spin 2024"
   },
   "text": "Van 01",
   "delay": 60
  },
  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input[type=text]",
    "nth": 1
