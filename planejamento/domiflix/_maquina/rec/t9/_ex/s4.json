   "max": 400
  },
  {
   "do": "text",
   "selector": "main",
   "name": "custos globais com a van",
   "max": 1800
  },
  {
   "do": "click",
   "target": {
    "text": "Van 01",
    "exact": true,
    "within": "main"
   },
   "after": 1200
  },
  {
   "do": "shot",
   "name": "93-van-detalhe"
  },
  {
   "do": "text",
   "selector": "main",
   "name": "detalhe da van",
   "max": 2200
