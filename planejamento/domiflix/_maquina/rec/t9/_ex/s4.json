  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input[placeholder='Valor mensal']",
    "nth": 0
   },
   "text": "1400",
   "delay": 60
  },
  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input[placeholder='Valor mensal']",
    "nth": 1
   },
   "text": "1620",
   "delay": 60
  },
  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input[placeholder='Valor anual']",
    "nth": 0
   },
   "text": "3600",
   "clear": true,
   "delay": 60
  },
  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input[placeholder='Valor anual']",
    "nth": 1
   },
   "text": "2400",
   "clear": true,
   "delay": 60
  },
  {
   "do": "eval",
   "js": "[...document.querySelectorAll('[role=dialog] input')].filter(i=>i.type!=='file').map(i=>[i.placeholder.slice(0,22),i.value].join('='))",
   "max": 700
  },
  {
   "do": "eval",
   "js": "[...document.querySelectorAll('[role=dialog] button#annual-0,[role=dialog] button#annual-1,[role=dialog] button#annual-2,[role=dialog] button#annual-3')].map(b=>[b.id,b.getAttribute('aria-checked'),b.getAttribute('data-state'),b.getAttribute('role'),b.getAttribute('aria-label'),b.title].join('|'))",
   "max": 600
  },
  {
   "do": "eval",
   "js": "(()=>{const d=document.querySelector('[role=dialog]');const sc=[...d.querySelectorAll('*')].filter(e=>e.scrollHeight>e.clientHeight+20&&['auto','scroll'].includes(getComputedStyle(e).overflowY));return sc.map(e=>[e.tagName,e.className.slice(0,60),e.scrollHeight,e.clientHeight].join('|'))})()",
   "max": 500
  },
  {
   "do": "text",
   "selector": "[role=dialog]",
   "name": "veiculo preenchido",
   "max": 2200
  },
  {
   "do": "shot",
   "name": "91-veiculo-preenchido"
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Salvar",
    "exact": true,
