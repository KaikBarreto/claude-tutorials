{
 "seedExtra": [
  "t3/apos-cap10",
  "t1/apos-cap13",
  "t4/inicio",
  "t4/apos-cap14",
  "t5/inicio",
  "t5/apos-cap05",
  "t11/inicio",
  "t11/_teste_rt"
 ],
 "start": "/dashboard",
 "stopOnFail": false,
 "steps": [
  {
   "do": "goto",
   "url": "/contratos"
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Novo Contrato",
    "exact": true
   }
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "keys",
   "target": {
    "selector": "[role=dialog] input",
    "nth": 0
   },
   "text": "PMOC - Hotel Mirante do Mar",
   "delay": 10
  },
  {
   "do": "click",
   "target": {
    "text": "Selecione o cliente"
   }
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "keys",
   "target": {
    "placeholder": "Buscar cliente..."
   },
   "text": "Hotel",
   "delay": 10
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "click",
   "target": {
    "selector": "[cmdk-item]",
    "hasText": "Hotel Mirante do Mar"
   }
  },
  {
   "do": "wait",
   "ms": 600
  },
  {
   "do": "click",
   "target": {
    "role": "switch",
    "name": "É um contrato PMOC?"
   }
  },
  {
   "do": "wait",
   "ms": 1200
  },
  {
   "do": "shot",
   "name": "30-info-pmoc"
  },
  {
   "do": "text",
   "selector": "[role=dialog]",
   "name": "INFO pmoc",
   "max": 4200
  },
  {
   "do": "eval",
   "js": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return 'campos info pmoc: '+[...d.querySelectorAll('input,textarea')].map((i,k)=>k+'|'+i.type+'|'+(i.placeholder||'')+'|'+i.value).join('  ##  ')})()"
  },
  {
   "do": "click",
   "target": {
    "text": "Selecione o RT..."
   }
  },
  {
   "do": "wait",
   "ms": 600
  },
  {
   "do": "shot",
   "name": "31-rt-lista"
  },
  {
   "do": "eval",
   "js": "[...document.querySelectorAll('[role=option]')].map(o=>o.innerText).join(' || ')"
  },
  {
   "do": "click",
   "target": {
    "role": "option",
    "name": "Ricardo",
    "exact": false
   }
  },
  {
   "do": "wait",
   "ms": 600
  },
  {
   "do": "hover",
   "target": {
    "role": "button",
    "name": "O que é Responsável Técnico?"
   }
  },
  {
   "do": "wait",
   "ms": 900
  },
  {
   "do": "shot",
   "name": "32-dica-rt"
  },
  {
   "do": "eval",
   "js": "document.querySelector('[role=tooltip]')?.innerText"
  },
  {
   "do": "keys",
   "target": {
    "placeholder": "Ex: Loja Centro, Galpão 2…"
   },
   "text": "Hotel Mirante do Mar - São Francisco",
   "delay": 10
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "do": "eval",
   "js": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return 'campos unidade: '+[...d.querySelectorAll('input,textarea')].map((i,k)=>k+'|'+i.type+'|'+(i.placeholder||'')+'|'+i.value).join('  ##  ')})()"
  },
  {
   "do": "eval",
   "js": "(()=>{const d=document.querySelector('[role=dialog]');const e=d.querySelector('.overflow-y-auto');return 'scrollH '+(e&&e.scrollHeight)+' client '+(e&&e.clientHeight)})()"
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Próximo",
    "exact": true
   }
  },
  {
   "do": "wait",
   "ms": 1100
  },
  {
   "do": "shot",
   "name": "33-escopo-pmoc"
  },
  {
   "do": "text",
   "selector": "[role=dialog]",
   "name": "ESCOPO pmoc",
   "max": 2600
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Adicionar ambiente",
    "exact": true
   }
  },
  {
   "do": "wait",
   "ms": 1000
  },
  {
   "do": "shot",
   "name": "34-ambiente"
  },
  {
   "do": "text",
   "selector": "[role=dialog]",
   "name": "AMBIENTE form",
   "max": 3500
  },
  {
   "do": "eval",
   "js": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return 'campos ambiente: '+[...d.querySelectorAll('input,textarea')].map((i,k)=>k+'|'+i.type+'|'+(i.placeholder||'')+'|'+i.value).join('  ##  ')})()"
  },
  {
   "do": "keys",
   "target": {
    "placeholder": "Ex: 2º andar — Sala 201"
   },
   "text": "Lobby e recepção",
   "delay": 10
  },
  {
   "do": "keys",
   "target": {
    "placeholder": "Ex: Escritório administrativo"
   },
   "text": "Recepção de hotel",
   "delay": 10
  },
  {
   "do": "click",
   "target": {
    "role": "button",
    "name": "Calcular",
    "exact": true,
    "nth": 0
   }
  },
  {
   "do": "wait",
   "ms": 900
  },
  {
   "do": "shot",
   "name": "35-calc-area"
  },
  {
   "do": "eval",
   "js": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return 'calc area: '+d.innerText.slice(0,1500)})()"
  },
  {
   "do": "eval",
   "js": "(()=>{const d=[...document.querySelectorAll('[role=dialog]')].pop();return 'campos calc: '+[...d.querySelectorAll('input,textarea')].map((i,k)=>k+'|'+i.type+'|'+(i.placeholder||'')+'|'+i.value).join('  ##  ')})()"
  }
 ]
}