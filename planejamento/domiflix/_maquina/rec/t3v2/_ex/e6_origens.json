{
  "seedExtra": ["t3v2/apos-cap03"],
  "start": "/clientes",
  "stopOnFail": false,
  "steps": [
    { "do": "waitFor", "text": "Lista de Clientes" },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e6-00-lista" },
    { "do": "eval", "js": "[...document.querySelectorAll('button,a')].filter(b=>/Configura/i.test((b.innerText||'')+(b.getAttribute('aria-label')||''))).map(b=>{const r=b.getBoundingClientRect();return [b.tagName,(b.innerText||'').trim().slice(0,30),Math.round(r.x),Math.round(r.y),Math.round(r.width),b.closest('main')?'main':'fora']})", "max": 800 },
    { "do": "count", "target": { "role": "button", "name": "Configurações", "exact": true, "within": "main" } },
    { "do": "hover", "target": { "role": "button", "name": "Configurações", "exact": true, "within": "main" } },
    { "do": "wait", "ms": 400 },
    { "do": "click", "target": { "role": "button", "name": "Configurações", "exact": true, "within": "main" } },
    { "do": "waitFor", "text": "Configurações de clientes e fornecedores", "timeout": 10 },
    { "do": "wait", "ms": 700 },
    { "do": "shot", "name": "e6-01-modal-origens" },
    { "do": "eval", "js": "(()=>{const d=document.querySelector('[role=dialog]');const r=d.getBoundingClientRect();return {dlg:[r.x,r.y,r.width,r.height].map(Math.round)}})()", "max": 300 },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] button')].map(b=>{const r=b.getBoundingClientRect();return [(b.innerText||b.getAttribute('aria-label')||b.title||'').trim().replace(/\\s+/g,' ').slice(0,28),b.getAttribute('aria-haspopup')||'',Math.round(r.x),Math.round(r.y),Math.round(r.width),Math.round(r.height)]})", "max": 2500 },
    { "do": "hover", "target": { "role": "button", "name": "Etiquetas", "within": "[role=dialog]" } },
    { "do": "hover", "target": { "role": "button", "name": "Campos personalizados", "within": "[role=dialog]" } },
    { "do": "hover", "target": { "role": "button", "name": "Origens", "within": "[role=dialog]" } },
    { "do": "list", "selector": "[role=dialog] h2" },
    { "do": "hover", "target": { "text": "Indicação", "exact": true, "within": "[role=dialog]" } },
    { "do": "hover", "target": { "text": "WhatsApp", "exact": true, "within": "[role=dialog]" } },
    { "do": "type", "target": { "placeholder": "Nova origem..." }, "text": "Site" },
    { "do": "shot", "name": "e6-02-digitou-site" },
    { "do": "click", "target": { "role": "button", "name": "Adicionar", "exact": true } },
    { "do": "waitFor", "text": "Origem criada", "timeout": 6 },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e6-03-site-criada" },
    { "do": "eval", "js": "[...document.querySelectorAll(\"[role=dialog] button[aria-haspopup='menu']\")].map((b,i)=>{const r=b.getBoundingClientRect();const row=b.closest('div[class*=flex]');return [i,Math.round(r.x),Math.round(r.y),(row&&row.innerText||'').trim().replace(/\\s+/g,' ').slice(0,30)]})", "max": 1500 },
    { "do": "hover", "target": { "selector": "[role=dialog] button[aria-haspopup='menu']", "nth": 3 } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e6-04-menu-nth3" },
    { "do": "list", "selector": "[role=menuitem]" },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 400 },
    { "do": "count", "target": { "role": "dialog" } },
    { "do": "shot", "name": "e6-05-depois-esc-menu" },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 700 },
    { "do": "count", "target": { "role": "dialog" } },
    { "do": "shot", "name": "e6-06-depois-esc-modal" }
  ]
}
