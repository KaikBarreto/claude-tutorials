    { "do": "click", "target": { "placeholder": "Nome do fornecedor" } },
    { "do": "press", "key": "Tab" },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return [a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "press", "key": "Tab" },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return [a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "type", "target": { "placeholder": "Nome do fornecedor" }, "text": "Ventura Gás e Tubos" },
    { "do": "type", "target": { "placeholder": "00.000.000/0000-00" }, "text": "91.345.605/0001-70" },
    { "do": "type", "target": { "placeholder": "Nome do contato" }, "text": "Rodrigo" },
    { "do": "type", "target": { "placeholder": "(00) 00000-0000" }, "text": "(21) 3000-3105" },
    { "do": "type", "target": { "placeholder": "email@fornecedor.com" }, "text": "vendas@venturagas.example" },
    { "do": "type", "target": { "placeholder": "Rua, número, bairro, cidade/UF e CEP" }, "text": "Rua das Palmeiras, 45, Niterói" },
    { "do": "type", "target": { "placeholder": "Anotações sobre o fornecedor..." }, "text": "Gás R-410A e tubo de cobre" },
    { "do": "shot", "name": "e3-02-form-preenchido" },
    { "do": "eval", "js": "(()=>{const sc=document.querySelector('[role=dialog] .overflow-y-auto');return {scrollTop: sc.scrollTop, scrollH: sc.scrollHeight, clientH: sc.clientHeight}})()" },
    { "do": "click", "target": { "role": "button", "name": "Sem etiquetas" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e3-03-popover" },
    { "do": "click", "target": { "role": "button", "name": "Preferencial", "exact": true } },
