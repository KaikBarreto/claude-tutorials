    { "do": "shot", "name": "e3-04-marcada" },
    { "do": "click", "target": { "role": "button", "name": "Salvar", "exact": true } },
    { "do": "waitFor", "text": "Fornecedor cadastrado", "timeout": 8 },
    { "do": "wait", "ms": 800 },
    { "do": "click", "target": { "text": "Ventura Gás e Tubos", "exact": true } },
    { "do": "waitFor", "text": "Nenhum gasto registrado", "timeout": 10 },
