{
  "seedExtra": ["t3v2/apos-cap10"],
  "start": "/equipamentos",
  "stopOnFail": false,
  "steps": [
    { "do": "waitFor", "text": "Lista de Equipamentos" },
    { "do": "wait", "ms": 600 },
    { "do": "click", "target": { "role": "button", "name": "Novo Equipamento" } },
    { "do": "waitFor", "target": { "placeholder": "Nome do equipamento" } },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "name": "e5-00-form" },
    { "do": "click", "target": { "role": "combobox", "name": "Selecione o cliente" } },
    { "do": "type", "target": { "placeholder": "Buscar cliente..." }, "text": "Colégio" },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e5-01-busca-cliente" },
    { "do": "list", "selector": "[role=option]" },
    { "do": "click", "target": { "role": "option", "name": "Colégio Monte Verde" } },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e5-02-cliente-escolhido" },
    { "do": "type", "target": { "placeholder": "Nome do equipamento" }, "text": "Hi-Wall 18.000 BTUs - Sala dos professores" },
    { "do": "click", "target": { "role": "combobox", "hasText": "Selecione", "within": "[role=dialog]", "nth": 0 } },
    { "do": "click", "target": { "role": "option", "name": "Split Hi-Wall" } },
    { "do": "wait", "ms": 400 },
    { "do": "shot", "name": "e5-03-categoria" },
    { "do": "click", "target": { "role": "button", "name": "Selecione uma ou mais etiquetas" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e5-04-etiquetas" },
    { "do": "list", "selector": "[data-radix-popper-content-wrapper] button" },
    { "do": "click", "target": { "role": "button", "name": "Em garantia", "exact": true } },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 400 },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return ['antes do Tab',a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "press", "key": "Tab" },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return ['tab1',a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "press", "key": "Tab" },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return ['tab2',a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "press", "key": "Tab" },
    { "do": "eval", "js": "(()=>{const a=document.activeElement;return ['tab3',a.tagName,(a.innerText||'').trim().slice(0,30),a.placeholder||'']})()" },
    { "do": "shot", "name": "e5-05-garantia-marcada" },
    { "do": "eval", "js": "(()=>{const d=document.querySelector('[role=dialog]');const sc=d.querySelector('.overflow-y-auto');const r=d.getBoundingClientRect();return {dlg:[r.x,r.y,r.width,r.height].map(Math.round),scrollTop:sc&&sc.scrollTop,scrollH:sc&&sc.scrollHeight,clientH:sc&&sc.clientHeight}})()", "max": 400 },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] input,[role=dialog] textarea,[role=dialog] button[role=combobox]')].map(e=>{const r=e.getBoundingClientRect();return [e.tagName,e.placeholder||(e.innerText||'').trim().slice(0,22),Math.round(r.x),Math.round(r.y),e.readOnly?'ro':'']})", "max": 2500 },
    { "do": "click", "target": { "role": "button", "name": "Criar", "exact": true } },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "name": "e5-06-criar-sem-cliente-ou-campos" }
  ]
}
