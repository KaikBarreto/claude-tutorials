{
  "seedExtra": ["t3v2/apos-cap09"],
  "start": "/equipamentos",
  "stopOnFail": false,
  "steps": [
    { "do": "waitFor", "text": "Lista de Equipamentos" },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e4-00-equipamentos" },
    { "do": "eval", "js": "[...document.querySelectorAll('main button,main a')].filter(b=>b.offsetParent).map(b=>{const r=b.getBoundingClientRect();return [(b.innerText||b.getAttribute('aria-label')||'').trim().replace(/\\s+/g,' ').slice(0,26),Math.round(r.x),Math.round(r.y)]}).slice(0,16)", "max": 900 },
    { "do": "hover", "target": { "role": "button", "name": "Configurar Campos" } },
    { "do": "click", "target": { "role": "button", "name": "Configurar Campos" } },
    { "do": "waitFor", "text": "Configurações de equipamentos", "timeout": 10 },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e4-01-abre-em-categorias" },
    { "do": "eval", "js": "(()=>{const d=document.querySelector('[role=dialog]');const r=d.getBoundingClientRect();const f=[...d.querySelectorAll('button')].filter(b=>/fechar|close/i.test((b.innerText||'')+(b.getAttribute('aria-label')||'')));return {dlg:[r.x,r.y,r.width,r.height].map(Math.round),fechar:f.map(b=>{const q=b.getBoundingClientRect();return [(b.innerText||'').trim(),Math.round(q.x),Math.round(q.y),Math.round(q.width),Math.round(q.height)]})}})()", "max": 600 },
    { "do": "click", "target": { "role": "button", "name": "Campos personalizados", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 800 },
    { "do": "shot", "name": "e4-02-campos" },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] textarea')].map((t,i)=>{const r=t.getBoundingClientRect();return [i,t.value.slice(0,22),Math.round(r.x),Math.round(r.y)]})", "max": 1200 },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] [role=switch]')].map((s,i)=>{const r=s.getBoundingClientRect();return [i,s.getAttribute('aria-label')||'',s.getAttribute('aria-checked'),Math.round(r.x),Math.round(r.y)]})", "max": 2500 },
    { "do": "hover", "target": { "selector": "[role=dialog] textarea", "nth": 0 } },
    { "do": "hover", "target": { "selector": "[role=dialog] textarea", "nth": 5 } },
    { "do": "hover", "target": { "role": "button", "name": "Arrastar para reordenar", "nth": 0 } },
    { "do": "click", "target": { "placeholder": "Nome do campo" } },
    { "do": "type", "target": { "placeholder": "Nome do campo" }, "text": "Tensão" },
    { "do": "click", "target": { "role": "combobox", "within": "[role=dialog]", "nth": "last" } },
    { "do": "wait", "ms": 400 },
    { "do": "click", "target": { "role": "option", "name": "Lista de opções" } },
    { "do": "wait", "ms": 400 },
    { "do": "shot", "name": "e4-03-novo-campo-lista" },
    { "do": "press", "key": "Tab", "delay": 60 },
    { "do": "type", "target": { "placeholder": "Opção 1" }, "text": "127 V" },
    { "do": "press", "key": ["Tab", "Tab", "Enter", "Shift+Tab", "Shift+Tab"], "delay": 50 },
    { "do": "type", "target": { "placeholder": "Opção 2" }, "text": "220 V" },
    { "do": "press", "key": ["Tab", "Tab", "Enter", "Shift+Tab", "Shift+Tab"], "delay": 50 },
    { "do": "type", "target": { "placeholder": "Opção 3" }, "text": "380 V" },
    { "do": "press", "key": "Tab", "times": 3, "delay": 50 },
    { "do": "shot", "name": "e4-04-opcoes" },
    { "do": "click", "target": { "role": "button", "name": "Adicionar campo" } },
    { "do": "waitFor", "text": "Campo criado", "timeout": 6 },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e4-04b-campo-criado" },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] [role=switch]')].map((s,i)=>{const r=s.getBoundingClientRect();return [i,s.getAttribute('aria-label')||'',s.getAttribute('aria-checked'),Math.round(r.x),Math.round(r.y)]}).slice(-6)", "max": 1500 },
    { "do": "click", "target": { "selector": "[role=dialog] button[role=switch]", "nth": "last" } },
    { "do": "wait", "ms": 700 },
    { "do": "shot", "name": "e4-04c-obrigatorio" },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] [role=switch]')].map((s,i)=>[i,s.getAttribute('aria-checked')]).slice(-6)", "max": 600 },
    { "do": "hover", "target": { "selector": "[role=dialog] textarea", "nth": 6 } },
    { "do": "click", "target": { "role": "button", "name": "Categorias", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 700 },
    { "do": "shot", "name": "e4-05-categorias" },
    { "do": "eval", "js": "(()=>{const i=document.querySelector('[role=dialog] input[type=color]');const p=i.parentElement;return p.outerHTML.slice(0,1200)})()", "max": 1300 },
    { "do": "hover", "target": { "text": "Split Hi-Wall", "exact": true } },
    { "do": "hover", "target": { "text": "Split Piso-Teto", "exact": true } },
    { "do": "type", "target": { "placeholder": "Nome da categoria" }, "text": "Multi Split" },
    { "do": "eval", "js": "(() => { const el = document.querySelector('[role=dialog] input[type=color]'); const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; set.call(el, '#14b8a6'); el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); return el.value; })()" },
    { "do": "eval", "js": "(()=>{const b=document.querySelector('[role=dialog] input[type=color] + button');const r=b.getBoundingClientRect();return [Math.round(r.x),Math.round(r.y),Math.round(r.width),b.disabled]})()" },
    { "do": "hover", "target": { "selector": "[role=dialog] input[type=color] + button" } },
    { "do": "click", "target": { "selector": "[role=dialog] input[type=color] + button" } },
    { "do": "waitFor", "text": "Categoria criada com sucesso", "timeout": 6 },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e4-06-categoria-criada" },
    { "do": "click", "target": { "role": "button", "name": "Etiquetas", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e4-07-etiquetas-equip" },
    { "do": "click", "target": { "role": "button", "name": "Nova etiqueta" } },
    { "do": "type", "target": { "placeholder": "Ex.: BLOQUEADO" }, "text": "Em garantia" },
    { "do": "click", "target": { "selector": "[role=dialog] button:has(span.font-mono)" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e4-08-seletor-cor" },
    { "do": "eval", "js": "(()=>{const b=document.querySelector('[title=\"#22C55E\"]');if(!b)return 'sem preset 22C55E';const r=b.getBoundingClientRect();return [Math.round(r.x),Math.round(r.y),Math.round(r.width)]})()" },
    { "do": "click", "target": { "title": "#22C55E", "exact": true } },
    { "do": "wait", "ms": 300 },
    { "do": "shot", "name": "e4-08b-verde" },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 400 },
    { "do": "count", "target": { "role": "dialog" } },
    { "do": "click", "target": { "role": "button", "name": "Salvar etiqueta", "exact": true } },
    { "do": "waitFor", "text": "Etiqueta criada", "timeout": 6 },
    { "do": "shot", "name": "e4-09-etiqueta-salva" },
    { "do": "click", "target": { "role": "button", "name": "Cancelar", "exact": true } },
    { "do": "wait", "ms": 400 },
    { "do": "shot", "name": "e4-10-depois-cancelar" }
  ]
}
