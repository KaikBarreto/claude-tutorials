{
  "seedExtra": ["t3v2/apos-cap06"],
  "start": "/clientes",
  "stopOnFail": false,
  "steps": [
    { "do": "waitFor", "text": "Lista de Clientes" },
    { "do": "click", "target": { "text": "Colégio Monte Verde", "exact": true } },
    { "do": "waitFor", "text": "Responsável no Local", "timeout": 10 },
    { "do": "wait", "ms": 600 },
    { "do": "shot", "name": "e2-00-ficha-com-etiquetas" },
    { "do": "click", "target": { "role": "button", "name": "Configurações", "within": "main" } },
    { "do": "waitFor", "text": "Configurações de clientes e fornecedores", "timeout": 10 },
    { "do": "click", "target": { "role": "button", "name": "Campos personalizados", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e2-01-campos" },
    { "do": "click", "target": { "role": "button", "name": "Novo campo" } },
    { "do": "wait", "ms": 400 },
    { "do": "shot", "name": "e2-02-novo-campo" },
    { "do": "list", "selector": "[role=dialog] input" },
    { "do": "type", "target": { "selector": "[role=dialog] section input", "nth": 0 }, "text": "Horário de acesso" },
    { "do": "click", "target": { "role": "combobox", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e2-03-tipos" },
    { "do": "list", "selector": "[role=option]" },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 400 },
    { "do": "count", "target": { "role": "dialog" } },
    { "do": "eval", "js": "[...document.querySelectorAll('[role=dialog] label')].map(l=>(l.innerText||'').trim().replace(/\\s+/g,' ').slice(0,60))", "max": 800 },
    { "do": "click", "target": { "role": "button", "name": "Salvar campo", "exact": true } },
    { "do": "waitFor", "text": "Campo criado", "timeout": 6 },
    { "do": "shot", "name": "e2-04-campo-criado" },
    { "do": "click", "target": { "role": "button", "name": "Cancelar", "exact": true } },
    { "do": "wait", "ms": 400 },
    { "do": "shot", "name": "e2-05-depois-cancelar" },
    { "do": "click", "target": { "role": "button", "name": "Fornecedores", "within": "[role=dialog]" } },
    { "do": "wait", "ms": 500 },
    { "do": "shot", "name": "e2-06-fornecedores" },
    { "do": "click", "target": { "role": "button", "name": "Clientes", "exact": true, "within": "[role=dialog]" } },
    { "do": "wait", "ms": 400 },
    { "do": "press", "key": "Escape" },
    { "do": "wait", "ms": 600 },
    { "do": "count", "target": { "role": "dialog" } },
    { "do": "hover", "target": { "selector": "button[aria-haspopup='menu'][aria-label='Ações']", "nth": 0 } },
    { "do": "wait", "ms": 500 },
    { "do": "click", "target": { "role": "menuitem", "name": "Editar" } },
    { "do": "waitFor", "text": "Editar Cliente", "timeout": 10 },
    { "do": "wait", "ms": 800 },
    { "do": "type", "target": { "label": "Horário de acesso" }, "text": "Depois das 17h ou aos sábados" },
    { "do": "shot", "name": "e2-07-form-com-campo" },
    { "do": "click", "target": { "role": "button", "name": "Salvar", "exact": true } },
    { "do": "wait", "ms": 1200 },
    { "do": "shot", "name": "e2-08-ficha-com-horario" },
    { "do": "text", "target": { "text": "Horário de acesso" }, "name": "linha-horario" }
  ]
}
